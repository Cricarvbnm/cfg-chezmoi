{{- $alec := promptBoolOnce . "alec" "Alec's preferences (deploy personal/secret content)?" true -}}
{{- $desktop := promptBoolOnce . "desktop" "Daily-use OS?" true -}}
{{- $proxyIP := promptStringOnce . "proxy.ip" "proxy IP" "127.0.0.1" -}}
{{- $pacman := ne (lookPath "pacman") "" -}}
# Generated by `chezmoi init` from .chezmoi.toml.tmpl — edit the template, not this file.

{{ if $alec -}}
encryption = 'gpg'

[gpg]
recipient = 'alechron'

{{ end -}}
[data]
alec = {{ $alec }}
desktop = {{ $desktop }}
proxy.ip = {{ $proxyIP | quote }}
windows = {{ eq .chezmoi.os "windows" }}
linux = {{ eq .chezmoi.os "linux" }}
pacman = {{ $pacman }}
