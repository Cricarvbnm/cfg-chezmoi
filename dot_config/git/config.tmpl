[init]
	defaultBranch = "main"

{{ if .alec }}
[user]
	email = "alechron@outlook.com"
	name = "Alec"
{{ end }}

[alias]
	a = "add"
	aa = "add --all"

	s = "status --short --branch"
	sl = "status"

	c = "commit"
	ca = "commit --all"
	cu = "commit --amend"

[core]
	autocrlf = "input"

{{ if eq .chezmoi.os "linux" -}}
[include]
	path = delta.conf

[core]
	askPass = ksshaskpass
{{- end }}
