{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "clock",
    "cpu",
    "temperature",
    "memory",
    "network",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "privacy",
    "idle_inhibitor",
    "pulseaudio",
    "backlight",
    "power-profiles-daemon",
    "upower"
    // "battery"
  ],
  // ── Hyprland workspace switcher ──
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "urgent": "",
      "focused": "",
      "default": ""
    }
  },
  // ── Hyprland window title ──
  "hyprland/window": {
    "format": "{class}: {title}",
    "separate-outputs": true
  },
  // ── Clock ──
  // hover to see the calendar tooltip
  "clock": {
    "interval": 30,
    "format": "{:%Y-%m-%d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
  },
  // ── System tray ──
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  // ── Privacy (screenshare / microphone / audio capture) ──
  "privacy": {
    "icon-size": 14,
    "transition-duration": 250
  },
  // ── Idle inhibitor toggle (keep screen awake) ──
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰤄",
      "deactivated": "󰒲"
    }
  },
  // ── Power profiles (power-saver / balanced / performance) ──
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "power-saver": "󰾆",
      "balanced": "󰾅",
      "performance": "󰾎"
    },
    "tooltip-format": "Power profile: {profile}",
    "on-click": "sh -c 'case $(powerprofilesctl get) in power-saver) powerprofilesctl set balanced ;; balanced) powerprofilesctl set performance ;; performance) powerprofilesctl set power-saver ;; esac'"
  },
  // ── Network (wired + wireless via NM) ──
  "network": {
    "interval": 5,
    "format-wifi": "󰖩  {ipaddr}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}  {ipaddr}  {frequency} MHz",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "max-length": 30
  },
  // ── Audio (PipeWire/PulseAudio) ──
  "pulseaudio": {
    "format": "󰕾  {volume}%",
    "format-muted": "󰝟",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "tooltip-format": "{desc}"
  },
  // ── Backlight ──
  "backlight": {
    "format": "󰖨  {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  // ── Temperature (CPU package) ──
  "temperature": {
    "thermal-zone": 5,
    "format": "󰔏  {temperatureC}°C",
    "critical-threshold": 90,
    "interval": 5
  },
  // ── CPU ──
  "cpu": {
    "interval": 2,
    "format": "󰻠  {usage}%",
    "on-click": "kitty -e btop"
  },
  // ── Memory ──
  "memory": {
    "interval": 5,
    "format": "󰍛  {percentage}%",
    "on-click": "kitty -e btop"
  },
  // ── UPower (external device batteries: bluetooth, etc.) ──
  "upower": {
    "format": "󰁹  {percentage}",
    "hide-if-empty": true
  },
  // // ── Battery (internal laptop battery) ──
  // "battery": {
  //   "interval": 60,
  //   "states": {
  //     "warning": 20,
  //     "critical": 10
  //   },
  //   "format": "{icon}  {capacity}%",
  //   "format-icons": [
  //     "󰁺",
  //     "󰁻",
  //     "󰁼",
  //     "󰁽",
  //     "󰁾",
  //     "󰁿",
  //     "󰂀",
  //     "󰂁",
  //     "󰂂"
  //   ],
  //   "format-charging": "{capacity}%  󰂄",
  //   "tooltip-format": "{timeTo}  {power} W"
  // }
}
