# External dependencies.
#
# Data comes from the config generated by .chezmoi.toml.tmpl.

# Everywhere
{{ if .windows }}["AppData/Local/nvim"]{{ else }}[".config/nvim"]{{ end }}
type = "git-repo"
url = "ssh://git@github.com/Cricarvbnm/cfg-lazyvim.git"
refreshPeriod = "168h"

# Personal knowledge vault
{{ if and .alec .desktop }}
["knowledge"]
type = "git-repo"
url = "ssh://git@github.com/Cricarvbnm/knowledge-vault.git"
refreshPeriod = "168h"
{{ end }}

# Presentation toolkit
{{ if .desktop }}
["Projects/ppt-master"]
type = "archive"
url = "https://github.com/hugohe3/ppt-master/archive/master.tar.gz"
stripComponents = 1
refreshPeriod = "168h"

# Rime input method data
[".local/share/fcitx5/rime"]
type = "archive"
url = "https://github.com/iDvel/rime-ice/archive/refs/heads/main.zip"
stripComponents = 1
refreshPeriod = "168h"

# Local pacman repository
{{ if .pacman }}
[".local/share/pacman/repo/local"]
type = "git-repo"
url = "git@github.com:Cricarvbnm/pacman-repo.git"
refreshPeriod = "168h"
{{ end }}
