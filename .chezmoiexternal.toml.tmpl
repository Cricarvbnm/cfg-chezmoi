# External dependencies.
#
# Data comes from the config generated by .chezmoi.toml.tmpl.

# Everywhere
[".config/nvim"]
type = "git-repo"
url = "ssh://git@codeberg.org/Alechron/cfg-lazyvim.git"
refreshPeriod = "168h"

# Personal knowledge vault
{{ if and .alec .desktop }}
["knowledge"]
type = "git-repo"
url = "ssh://git@codeberg.org/Alechron/knowledge-vault.git"
refreshPeriod = "168h"
{{ end }}

# Presentation toolkit
{{ if .desktop }}
["Projects/ppt-master"]
type = "archive"
url = "https://github.com/hugohe3/ppt-master/archive/master.tar.gz"
stripComponents = 1
refreshPeriod = "168h"
{{ end }}

{{ if and .linux .desktop }}
# Rime input method data
[".local/share/fcitx5/rime"]
type = "archive"
url = "https://github.com/iDvel/rime-ice/archive/refs/heads/main.zip"
stripComponents = 1
refreshPeriod = "168h"

# Pandoc LaTeX template
["Templates/pandoc/pandoc-latex-template"]
type = "archive"
url = "https://github.com/Wandmalfarbe/pandoc-latex-template/archive/master.tar.gz"
stripComponents = 1
refreshPeriod = "168h"
{{ end }}

# Local pacman repository
{{ if .pacman }}
[".local/share/pacman/repo/local"]
type = "git-repo"
url = "git@github.com:Cricarvbnm/pacman-repo.git"
refreshPeriod = "168h"
{{ end }}
