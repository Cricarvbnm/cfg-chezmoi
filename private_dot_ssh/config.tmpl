{{- $proxyPort := 7890 -}}
Include config.d/*
{{ if .proxy }}
Host !*.local *
	ProxyCommand connect -H {{ .proxy.ip }}:{{ $proxyPort }} %h %p
{{- end }}

{{ if .linux -}}
# 连接复用：复用同一条 TCP 连接，避免每次 ssh 都走代理+握手
Host *
	ControlMaster auto
	ControlPath ~/.ssh/cm/%r@%h:%p
	ControlPersist 300
	ServerAliveInterval 30
	ServerAliveCountMax 3
	ConnectTimeout 10
{{- end }}
