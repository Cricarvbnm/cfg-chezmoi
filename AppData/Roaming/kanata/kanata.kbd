;; Esc -> Caps; Caps -> Esc when tapped, left Ctrl when held.
;; Physical modifiers, navigation keys and function keys bypass Kanata.

(defcfg
  process-unmapped-keys no
)

(defsrc
  esc
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l ; ' ret
  z x c v b n m , . /
  spc
)

(defalias
  ;; Captured typing keys trigger Ctrl immediately when pressed after Caps.
  ;; For bypassed keys, hold Caps for 200 ms before pressing the next key.
  ctl (tap-hold-press 200 200 esc lctl)
)

(deflayer base
  caps
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  @ctl a s d f g h j k l ; ' ret
  z x c v b n m , . /
  spc
)
